# LuckyPulse environment — copy to `.env` and fill in. NEVER commit `.env`.
# All keys are server-only (read via runtimeConfig in Nitro routes); the client never sees them.

# Twitch Dev App (https://dev.twitch.tv/console -> Register Your Application)
# Used for live-stream auto-discovery via the Helix API. The iframe embed itself needs no key.
NUXT_TWITCH_CLIENT_ID=
NUXT_TWITCH_CLIENT_SECRET=

# Sport data API (optional, for real live scores/fixtures). Example: API-Football.
NUXT_SPORT_API_KEY=
